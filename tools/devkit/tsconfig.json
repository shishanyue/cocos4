{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "build",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": false,
    "noEmitOnError": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["probes/**/*.ts", "src/**/*.ts"]
}
