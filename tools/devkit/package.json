{
  "name": "@cocos4/devkit-probes",
  "version": "0.0.0",
  "private": true,
  "description": "Development MCP/CLI, offline game SDK and maintainer tools; portable release acceptance is incomplete.",
  "type": "module",
  "engines": {
    "node": ">=18.20.8"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc && npm run build:host",
    "build:host": "node scripts/build-host.mjs",
    "test": "npm run build && node scripts/test.mjs",
    "export:apk": "node android/export-apk.mjs",
    "apk": "node android/cli.mjs",
    "android:doctor": "node android/toolchain.mjs doctor",
    "android:build": "node android/toolchain.mjs build",
    "android:build:direct": "node android/direct-build.mjs",
    "test:android": "npm run check && node node_modules/typescript/bin/tsc && node --test test/android-export.test.mjs test/android-templates.test.mjs test/android-direct-build.test.mjs test/android-cli.test.mjs test/android-hosting.test.mjs",
    "prepare:sdk": "node scripts/prepare-sdk.mjs",
    "prepare:release": "npm run build && node scripts/prepare-release.mjs",
    "verify:portable": "node scripts/verify-portable-host.mjs",
    "start": "node build/src/cli.js"
  },
  "devDependencies": {
    "@cocos/module-system": "0.0.21",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/node": "18.19.130",
    "ajv": "8.20.0",
    "json5": "2.2.3",
    "typescript": "5.9.3",
    "zod": "3.25.76"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": {
      "@hono/node-server": "1.19.9"
    }
  }
}
